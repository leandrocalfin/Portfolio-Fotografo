# multer-storage-cloudinary@4 declara como peer "cloudinary ^1.21.0"
# pero su código solo usa APIs que existen idénticas en cloudinary 2.x
# (verificado: uploader.upload_stream / uploader.destroy).
# Le decimos a npm que ignore el conflicto de peers en TODOS los entornos
# (local y Render), porque la compatibilidad fue verificada a mano.
legacy-peer-deps=true
